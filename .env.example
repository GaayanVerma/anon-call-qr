# Which provider answers calls: twilio (default) or exotel (Indian numbers)
VOICE_PROVIDER=twilio

# --- Twilio (VOICE_PROVIDER=twilio) ---
# Twilio credentials (Console > Account > API keys & tokens)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number scanners dial, in E.164 format (e.g. +91XXXXXXXXXX)
TWILIO_NUMBER=
# Public HTTPS base URL Twilio reaches this app at (your ngrok URL locally), no trailing slash
PUBLIC_BASE_URL=
# --- Exotel (VOICE_PROVIDER=exotel) ---
# Your ExoPhone in E.164 format, e.g. +918047112233 (printed on stickers)
EXOTEL_NUMBER=
# Long random string (24+ chars) that forms part of every Exotel webhook URL
EXOTEL_WEBHOOK_SECRET=

# --- Always required ---
# Long random strings: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_PASSWORD=
HASH_SALT=

# Optional
# DATABASE_URL=sqlite:///app.db
# SESSION_COOKIE_SECURE=1          # set to 0 only for http://localhost admin access
# TTS_VOICE=Polly.Raveena
# TTS_LANGUAGE=en-IN
# MAX_CALLS_PER_CALLER_PER_HOUR=3
# MAX_CALLS_PER_OWNER_PER_HOUR=5
